{
  "name": "ai-video-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --require ./scripts/fs-guard.cjs ./node_modules/next/dist/bin/next dev --webpack",
    "build": "node --require ./scripts/fs-guard.cjs ./node_modules/next/dist/bin/next build --webpack",
    "start": "next start",
    "worker": "ts-node scripts/image-restore-worker.ts",
    "elevenlabs:example": "ts-node --esm scripts/elevenlabs-example.mts",
    "lint": "node --require ./scripts/fs-guard.cjs ./node_modules/eslint/bin/eslint.js",
    "check:nav": "node ./scripts/check-bottom-nav-routes.cjs"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.58.0",
    "@sentry/nextjs": "^10.63.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "bullmq": "^5.76.5",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "next": "16.2.4",
    "openai": "^6.36.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "replicate": "^1.4.0",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "pm2": "^5.3.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.1",
    "typescript": "^5"
  }
}
